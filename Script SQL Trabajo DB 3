-- 1. PROGRAMA ACADEMICO
CREATE TABLE programa_academico (
    id_programa INTEGER GENERATED BY DEFAULT AS IDENTITY,
    nombre VARCHAR(80) NOT NULL UNIQUE,
    facultad VARCHAR(80) NOT NULL,
    nivel_formacion VARCHAR(20) NOT NULL,
    CONSTRAINT pk_programa_academico
        PRIMARY KEY (id_programa)
);

-- 2. ESTUDIANTE
CREATE TABLE estudiante (
    id_estudiante INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_programa INTEGER NOT NULL,
    correo_institucional VARCHAR(120) NOT NULL UNIQUE,
    nombre VARCHAR(60) NOT NULL,
    apellido VARCHAR(60) NOT NULL,
    semestre INTEGER NOT NULL,
    biografia VARCHAR(300),
    foto_url VARCHAR(255),
    fecha_registro DATE NOT NULL,
    estado VARCHAR(15) NOT NULL,
    CONSTRAINT pk_estudiante
        PRIMARY KEY (id_estudiante),
    CONSTRAINT fk_estudiante_programa
        FOREIGN KEY (id_programa)
        REFERENCES programa_academico (id_programa)
);

-- 3. INTERES
CREATE TABLE interes (
    id_interes INTEGER GENERATED BY DEFAULT AS IDENTITY,
    nombre VARCHAR(60) NOT NULL UNIQUE,
    categoria VARCHAR(40) NOT NULL,
    CONSTRAINT pk_interes
        PRIMARY KEY (id_interes)
);

-- 4. ESTUDIANTE_INTERES
CREATE TABLE estudiante_interes (
    id_estudiante INTEGER,
    id_interes INTEGER,
    CONSTRAINT pk_estudiante_interes
        PRIMARY KEY (id_estudiante, id_interes),
    CONSTRAINT fk_ei_estudiante
        FOREIGN KEY (id_estudiante)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_ei_interes
        FOREIGN KEY (id_interes)
        REFERENCES interes (id_interes)
);

-- 5. HABILIDAD
CREATE TABLE habilidad (
    id_habilidad INTEGER GENERATED BY DEFAULT AS IDENTITY,
    nombre VARCHAR(60) NOT NULL UNIQUE,
    disciplina VARCHAR(40) NOT NULL,
    CONSTRAINT pk_habilidad
        PRIMARY KEY (id_habilidad)
);

-- 6. ESTUDIANTE_HABILIDAD
CREATE TABLE estudiante_habilidad (
    id_estudiante INTEGER,
    id_habilidad INTEGER,
    nivel VARCHAR(20) NOT NULL,
    CONSTRAINT pk_estudiante_habilidad
        PRIMARY KEY (id_estudiante, id_habilidad),
    CONSTRAINT fk_eh_estudiante
        FOREIGN KEY (id_estudiante)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_eh_habilidad
        FOREIGN KEY (id_habilidad)
        REFERENCES habilidad (id_habilidad)
);

-- 7. SEGUIMIENTO
CREATE TABLE seguimiento (
    id_seguidor INTEGER,
    id_seguido INTEGER,
    tipo_vinculo VARCHAR(20) NOT NULL,
    fecha_inicio DATE NOT NULL,
    CONSTRAINT pk_seguimiento
        PRIMARY KEY (id_seguidor, id_seguido),
    CONSTRAINT fk_seguimiento_seguidor
        FOREIGN KEY (id_seguidor)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_seguimiento_seguido
        FOREIGN KEY (id_seguido)
        REFERENCES estudiante (id_estudiante)
);

-- 8. GRUPO
CREATE TABLE grupo (
    id_grupo INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_creador INTEGER NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    descripcion VARCHAR(300),
    tipo VARCHAR(30) NOT NULL,
    privacidad VARCHAR(15) NOT NULL,
    fecha_creacion DATE NOT NULL,
    CONSTRAINT pk_grupo
        PRIMARY KEY (id_grupo),
    CONSTRAINT fk_grupo_creador
        FOREIGN KEY (id_creador)
        REFERENCES estudiante (id_estudiante)
);

-- 9. MEMBRESIA
CREATE TABLE membresia (
    id_estudiante INTEGER,
    id_grupo INTEGER,
    rol VARCHAR(20) NOT NULL,
    fecha_ingreso DATE NOT NULL,
    estado VARCHAR(15) NOT NULL,
    CONSTRAINT pk_membresia
        PRIMARY KEY (id_estudiante, id_grupo),
    CONSTRAINT fk_membresia_estudiante
        FOREIGN KEY (id_estudiante)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_membresia_grupo
        FOREIGN KEY (id_grupo)
        REFERENCES grupo (id_grupo)
);

-- 10. PUBLICACION
CREATE TABLE publicacion (
    id_publicacion INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_autor INTEGER NOT NULL,
    id_grupo INTEGER,
    tipo VARCHAR(30) NOT NULL,
    contenido TEXT NOT NULL,
    fecha_publicacion TIMESTAMP NOT NULL,
    CONSTRAINT pk_publicacion
        PRIMARY KEY (id_publicacion),
    CONSTRAINT fk_publicacion_autor
        FOREIGN KEY (id_autor)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_publicacion_grupo
        FOREIGN KEY (id_grupo)
        REFERENCES grupo (id_grupo)
);

-- 11. COMENTARIO
CREATE TABLE comentario (
    id_comentario INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_publicacion INTEGER NOT NULL,
    id_autor INTEGER NOT NULL,
    contenido VARCHAR(500) NOT NULL,
    fecha_comentario TIMESTAMP NOT NULL,
    CONSTRAINT pk_comentario
        PRIMARY KEY (id_comentario),
    CONSTRAINT fk_comentario_publicacion
        FOREIGN KEY (id_publicacion)
        REFERENCES publicacion (id_publicacion),
    CONSTRAINT fk_comentario_autor
        FOREIGN KEY (id_autor)
        REFERENCES estudiante (id_estudiante)
);

-- 12. REACCION
CREATE TABLE reaccion (
    id_publicacion INTEGER,
    id_estudiante INTEGER,
    tipo_reaccion VARCHAR(20) NOT NULL,
    fecha_reaccion TIMESTAMP NOT NULL,
    CONSTRAINT pk_reaccion
        PRIMARY KEY (id_publicacion, id_estudiante),
    CONSTRAINT fk_reaccion_publicacion
        FOREIGN KEY (id_publicacion)
        REFERENCES publicacion (id_publicacion),
    CONSTRAINT fk_reaccion_estudiante
        FOREIGN KEY (id_estudiante)
        REFERENCES estudiante (id_estudiante)
);

-- 13. RECURSO_PUBLICACION
CREATE TABLE recurso_publicacion (
    id_recurso INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_publicacion INTEGER NOT NULL,
    url VARCHAR(255) NOT NULL,
    tipo_recurso VARCHAR(20) NOT NULL,
    CONSTRAINT pk_recurso_publicacion
        PRIMARY KEY (id_recurso),
    CONSTRAINT fk_recurso_publicacion
        FOREIGN KEY (id_publicacion)
        REFERENCES publicacion (id_publicacion)
);

-- 14. EVENTO
CREATE TABLE evento (
    id_evento INTEGER GENERATED BY DEFAULT AS IDENTITY,
    id_organizador INTEGER NOT NULL,
    id_grupo INTEGER,
    titulo VARCHAR(120) NOT NULL,
    descripcion VARCHAR(300),
    tipo VARCHAR(30) NOT NULL,
    modalidad VARCHAR(15) NOT NULL,
    fecha_hora_inicio TIMESTAMP NOT NULL,
    fecha_hora_fin TIMESTAMP NOT NULL,
    lugar VARCHAR(150),
    enlace_virtual VARCHAR(255),
    CONSTRAINT pk_evento
        PRIMARY KEY (id_evento),
    CONSTRAINT fk_evento_organizador
        FOREIGN KEY (id_organizador)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_evento_grupo
        FOREIGN KEY (id_grupo)
        REFERENCES grupo (id_grupo)
);

-- 15. ASISTENCIA
CREATE TABLE asistencia (
    id_estudiante INTEGER,
    id_evento INTEGER,
    estado_confirmacion VARCHAR(15) NOT NULL,
    fecha_registro DATE NOT NULL,
    CONSTRAINT pk_asistencia
        PRIMARY KEY (id_estudiante, id_evento),
    CONSTRAINT fk_asistencia_estudiante
        FOREIGN KEY (id_estudiante)
        REFERENCES estudiante (id_estudiante),
    CONSTRAINT fk_asistencia_evento
        FOREIGN KEY (id_evento)
        REFERENCES evento (id_evento)
);
